{
  "expo": {
    "name": "Mobile POS & Inventory",
    "slug": "Mobile_POS_Inventory_System",
    "scheme": "mobile-pos-inventory-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.nikozen1.Mobile_POS_Inventory_System"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow this app to scan product barcodes",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "baf46868-daca-4602-a921-7e2dfe5fd339"
      }
    }
  }
}
